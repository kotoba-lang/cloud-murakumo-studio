{:paths ["src"]
 ;; real git pins for standalone (non-monorepo) consumption; :dev overrides to
 ;; sibling :local/root when checked out inside the com-junkawasaki west
 ;; superproject (same convention as kotoba-lang/inference's own deps.edn).
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/json {:git/sha "4c55a247b020bfb1c7b5b09f9df8f3fa5601a207"}
       io.github.kotoba-lang/inference {:git/sha "4cc7461e5a95cf84814e10badd82199d09fd0724"}
        io.github.kotoba-lang/http {:git/sha "719a21036326f00483d1a7e4bf8410f6b0c77499"}
}

 :aliases
 {;; local monorepo dev (checked out at orgs/kotoba-lang/murakumo-studio,
  ;; sibling to orgs/kotoba-lang/inference): `kbb -M:dev:engine`.
  :dev {:override-deps {io.github.kotoba-lang/inference {:local/root "../inference"}}}

  ;; frontend (shadow-cljs :app build → desktop/dist/js). appkit transitively
  ;; pulls kotoba-ui → liquid-glass-ui → shitsuke (ADR-2607022800/0033).
  :cljs
  {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}
                reagent/reagent {:mvn/version "1.2.0"}
                io.github.kotoba-lang/appkit {:local/root "../appkit"}}}

  ;; JVM inference engine sidecar entry point (spawned by the Tauri shell).
  ;; Standalone clone: `kbb -M:engine`. Monorepo dev: `kbb -M:dev:engine`.
  :engine
  {:extra-deps {http-kit/http-kit {:mvn/version "2.8.1"}}
   :main-opts ["-m" "murakumo-studio.engine"]}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
